PHARMACY_NAME=Khawajgan Pharmacy

# Comma-separated list of allowed frontend origins (no trailing slashes).
# Localhost origins are always added automatically for local development.
# Production: add your Vercel URL + any other frontends.
ALLOWED_ORIGINS=https://khawajgan-pharmacy-software.vercel.app,http://localhost:3000

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true in production (Vercel uses HTTPS so cookies need Secure flag)
COOKIE_SECURE=true

# Google OAuth — create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI you configure in Google Cloud Console
GOOGLE_REDIRECT_URI=https://khawajgan-pharmacy-software.vercel.app/api/auth/google/callback

# Frontend URL — used to redirect the browser after Google OAuth completes
FRONTEND_URL=https://khawajgan-pharmacy-software.vercel.app

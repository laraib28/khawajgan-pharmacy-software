# Next.js rewrites /api/* → BACKEND_URL/* on the server side.
# Browser never calls this URL directly — no CORS or mixed-content issues.
#
# Local development:
BACKEND_URL=http://localhost:8000

# Production (set this in Vercel environment variables, not here):
# BACKEND_URL=http://167.172.93.19:8000

NEXT_PUBLIC_PHARMACY_NAME=Khawajgan Pharmacy
